{
  "schemaVersion": 1,
  "id": "simplyspeakers",
  "version": "${version}",
  "name": "Simply Speakers",
  "description": "Custom, synchronized speaker networks with portable audio and redstone control.",
  "authors": [
    "NsTut"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.nstut.simplyspeakers.fabric.SimplySpeakersFabric"
    ],
    "preLaunch": [
      "com.nstut.fabric.simplyspeakers.OpenUiDependencyCheck"
    ]
  },
  "mixins": [
    "simplyspeakers.mixins.json"
  ],
  "depends": {
    "minecraft": "1.16.5",
    "java": ">=8",
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "architectury": ">=1.32.68",
    "packetweave": ">=0.1.4"
  },
  "suggests": {
    "openui_mc": ">=0.0.15"
  }
}
